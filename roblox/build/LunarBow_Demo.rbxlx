      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">BowAnimator</string>
          <string name="Source"><![CDATA[--!strict
-- One animation API for the bow, whatever the backend:
--   * Config.AnimationIds[name] set  -> Roblox Animator (AnimationTrack, replicates by itself)
--   * empty id                       -> built-in KeyframePlayer (the owner relays play/stop to
--                                       the server so other clients can mirror it)

local Config = require(script.Parent.Config)
local KeyframePlayer = require(script.Parent.KeyframePlayer)

export type Connection = { Disconnect: (self: any) -> () }
export type MarkerSignal = { Connect: (self: any, fn: (value: string?) -> ()) -> Connection }

export type Track = {
	Name: string,
	Builtin: boolean,
	Length: number,
	Play: (self: Track, fadeTime: number?, weight: number?, speed: number?) -> (),
	Stop: (self: Track, fadeTime: number?) -> (),
	AdjustSpeed: (self: Track, speed: number) -> (),
	IsPlaying: (self: Track) -> boolean,
	OnMarker: (self: Track, name: string, fn: (value: string?) -> ()) -> Connection,
	OnStopped: (self: Track, fn: () -> ()) -> Connection,
}

export type Relay = (name: string, action: string, fadeTime: number?, speed: number?) -> ()

export type BowAnimator = {
	Character: Model,
	Get: (self: BowAnimator, name: string) -> Track,
	Play: (self: BowAnimator, name: string, fadeTime: number?, weight: number?, speed: number?) -> Track,
	Stop: (self: BowAnimator, name: string, fadeTime: number?) -> (),
	StopAll: (self: BowAnimator, fadeTime: number?, except: { [string]: boolean }?) -> (),
	Destroy: (self: BowAnimator) -> (),
}

local BowAnimator = {}

local function normaliseId(id: string): string
	if id:match("^%d+$") then
		return "rbxassetid://" .. id
	end
	return id
end

function BowAnimator.usesBuiltin(name: string): boolean
	local id = (Config.AnimationIds :: { [string]: string })[name]
	return id == nil or id == "" or id == "rbxassetid://0"
end

local function wrapRoblox(name: string, animator: Animator, id: string): Track
	local anim = Instance.new("Animation")
	anim.Name = "LunarBow_" .. name
	anim.AnimationId = normaliseId(id)
	local rt = animator:LoadAnimation(anim)
	local track = {
		Name = name,
		Builtin = false,
		Length = 0,
	} :: Track
	function track.Play(self: Track, fadeTime: number?, weight: number?, speed: number?)
		rt:Play(fadeTime or 0.1, weight or 1, speed or 1)
		self.Length = rt.Length
	end
	function track.Stop(_: Track, fadeTime: number?)
		rt:Stop(fadeTime or 0.1)
	end
	function track.AdjustSpeed(_: Track, speed: number)
		rt:AdjustSpeed(speed)
	end
	function track.IsPlaying(_: Track): boolean
		return rt.IsPlaying
	end
	function track.OnMarker(_: Track, marker: string, fn: (value: string?) -> ()): Connection
		return rt:GetMarkerReachedSignal(marker):Connect(fn) :: any
	end
	function track.OnStopped(_: Track, fn: () -> ()): Connection
		return rt.Stopped:Connect(fn) :: any
	end
	task.spawn(function()
		-- Length is 0 until the asset has loaded
		local t0 = os.clock()
		while rt.Length == 0 and os.clock() - t0 < 5 do
			task.wait()
		end
		track.Length = rt.Length
	end)
	return track
end

local function wrapBuiltin(name: string, character: Model, relay: Relay?): Track
	local kt = KeyframePlayer.load(character, name)
	local track = {
		Name = name,
		Builtin = true,
		Length = kt.Length,
	} :: Track
	function track.Play(_: Track, fadeTime: number?, weight: number?, speed: number?)
		kt:Play(fadeTime, weight, speed)
		if relay then
			relay(name, "play", fadeTime, speed)
		end
	end
	function track.Stop(_: Track, fadeTime: number?)
		if kt:IsPlaying() and relay then
			relay(name, "stop", fadeTime, nil)
		end
		kt:Stop(fadeTime)
	end
	function track.AdjustSpeed(_: Track, speed: number)
		kt:AdjustSpeed(speed)
		if relay then
			relay(name, "speed", nil, speed)
		end
	end
	function track.IsPlaying(_: Track): boolean
		return kt:IsPlaying()
	end
	function track.OnMarker(_: Track, marker: string, fn: (value: string?) -> ()): Connection
		return kt:GetMarkerReachedSignal(marker):Connect(fn)
	end
	function track.OnStopped(_: Track, fn: () -> ()): Connection
		return kt.Stopped:Connect(fn)
	end
	return track
end

-- `relay` (optional) is called for built-in tracks so the owner can replicate them.
function BowAnimator.new(character: Model, relay: Relay?): BowAnimator
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local animator: Animator? = nil
	if humanoid then
		animator = humanoid:FindFirstChildOfClass("Animator")
		if not animator then
			local a = Instance.new("Animator")
			a.Parent = humanoid
			animator = a
		end
	end

	local tracks: { [string]: Track } = {}
	local self = { Character = character } :: BowAnimator

	function self.Get(_: BowAnimator, name: string): Track
		local track = tracks[name]
		if track then
			return track
		end
		local id = (Config.AnimationIds :: { [string]: string })[name]
		local created: Track
		if not BowAnimator.usesBuiltin(name) and animator then
			created = wrapRoblox(name, animator, id)
		else
			created = wrapBuiltin(name, character, relay)
		end
		tracks[name] = created
		return created
	end

	function self.Play(s: BowAnimator, name: string, fadeTime: number?, weight: number?, speed: number?): Track
		local track = s:Get(name)
		track:Play(fadeTime, weight, speed)
		return track
	end

	function self.Stop(_: BowAnimator, name: string, fadeTime: number?)
		local track = tracks[name]
		if track then
			track:Stop(fadeTime)
		end
	end

	function self.StopAll(_: BowAnimator, fadeTime: number?, except: { [string]: boolean }?)
		for name, track in tracks do
			if not (except and except[name]) then
				track:Stop(fadeTime)
			end
		end
	end

	function self.Destroy(s: BowAnimator)
		s:StopAll(0.1)
		table.clear(tracks)
	end

	return self
end

return BowAnimator
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">BowAssembly</string>
          <string name="Source"><![CDATA[--!strict
-- Turns the imported MeshParts inside the Tool into a ready-to-use bow:
-- sizes/positions them from BowLayout (so the import unit does not matter),
-- welds everything to an invisible "BowHandle", styles the materials and adds
-- the string (Beams), light, particles and swing trails.
--
-- Expected MeshParts anywhere inside the Tool (names from LunarBow.fbx):
--   Limbs, Armor, Grip, Crystals, Aura
-- If they are missing, a primitive placeholder is built so the tool still works.

local CollectionService = game:GetService("CollectionService")

local Config = require(script.Parent.Config)
local Layout = require(script.Parent.BowLayout)

local BowAssembly = {}

BowAssembly.Tag = "LunarBow"
BowAssembly.MeshNames = { "Limbs", "Armor", "Grip", "Crystals", "Aura" }
BowAssembly.SparkleTexture = "rbxasset://textures/particles/sparkles_main.dds"

local function findPart(root: Instance, name: string): BasePart?
	local exact = root:FindFirstChild(name, true)
	if exact and exact:IsA("BasePart") then
		return exact
	end
	local lname = name:lower()
	for _, d in root:GetDescendants() do
		if d:IsA("BasePart") and d.Name:lower():find(lname, 1, true) then
			return d
		end
	end
	return nil
end

local function quiet(part: BasePart)
	part.Anchored = false
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Massless = true
end

local function weld(handle: BasePart, part: BasePart, offset: CFrame)
	part.CFrame = handle.CFrame * offset
	local w = Instance.new("Weld")
	w.Name = "BowWeld"
	w.Part0 = handle
	w.Part1 = part
	w.C0 = offset
	w.Parent = part
end

local function style(name: string, part: BasePart)
	local hasSA = part:FindFirstChildOfClass("SurfaceAppearance") ~= nil
	part.CastShadow = name ~= "Aura" and name ~= "Crystals"
	if name == "Crystals" then
		part.Material = Enum.Material.Neon
		part.Color = Config.Colors.Glow
	elseif name == "Aura" then
		part.Material = Enum.Material.ForceField
		part.Color = Config.Colors.GlowDeep
		part.Transparency = Config.AuraIdleTransparency
	elseif not hasSA then
		if name == "Limbs" then
			part.Material = Enum.Material.Metal
			part.Color = Config.Colors.Body
		elseif name == "Armor" then
			part.Material = Enum.Material.Metal
			part.Color = Config.Colors.Gold
		elseif name == "Grip" then
			part.Material = Enum.Material.Fabric
			part.Color = Config.Colors.Grip
		end
		local tex = (Config.TextureIds :: { [string]: string })[name]
		if tex and tex ~= "" and part:IsA("MeshPart") then
			part.TextureID = tex
		end
	end
end

local function buildPlaceholder(handle: BasePart, parent: Instance, scale: number)
	-- a chain of cylinders along the limb centreline + gold caps and a glowing core
	local model = Instance.new("Model")
	model.Name = "PlaceholderBow"
	local pts = Layout.Centerline
	for i = 1, #pts - 1 do
		local a, b = pts[i].Position * scale, pts[i + 1].Position * scale
		local mid, len = (a + b) / 2, (b - a).Magnitude
		local r = (pts[i].Radius + pts[i + 1].Radius) * scale
		local seg = Instance.new("Part")
		seg.Name = "Limb" .. i
		seg.Shape = Enum.PartType.Cylinder
		seg.Size = Vector3.new(len + r * 0.5, r * 1.6, r * 1.6)
		seg.Material = Enum.Material.Metal
		seg.Color = Config.Colors.Body
		quiet(seg)
		-- cylinder axis is X: aim it along the segment
		local offset = CFrame.lookAt(mid, b) * CFrame.Angles(0, math.rad(90), 0)
		weld(handle, seg, offset)
		seg.Parent = model
		if i % 4 == 0 then
			local band = seg:Clone()
			band.Name = "Band" .. i
			band.Size = Vector3.new(r * 0.9, r * 2.3, r * 2.3)
			band.Color = Config.Colors.Gold
			band:ClearAllChildren()
			weld(handle, band, offset)
			band.Parent = model
		end
	end
	local core = Instance.new("Part")
	core.Name = "Crystals"
	core.Shape = Enum.PartType.Ball
	core.Size = Vector3.one * 0.22 * scale
	core.Material = Enum.Material.Neon
	core.Color = Config.Colors.Glow
	quiet(core)
	weld(handle, core, CFrame.new(Layout.Points.CoreLight * scale))
	core.Parent = model
	model.Parent = parent
end

local function attachment(handle: BasePart, name: string, pos: Vector3): Attachment
	local a = Instance.new("Attachment")
	a.Name = name
	a.Position = pos
	a.Parent = handle
	return a
end

local function beam(name: string, a0: Attachment, a1: Attachment, width: number, transparency: number): Beam
	local b = Instance.new("Beam")
	b.Name = name
	b.Attachment0 = a0
	b.Attachment1 = a1
	b.Width0 = width
	b.Width1 = width
	b.FaceCamera = true
	b.Segments = 1
	b.LightEmission = 1
	b.LightInfluence = 0
	b.Color = ColorSequence.new(Config.Colors.Glow)
	b.Transparency = NumberSequence.new(transparency)
	pcall(function()
		(b :: any).Brightness = 3
	end)
	b.Parent = a0.Parent
	return b
end

local function trail(name: string, a0: Attachment, a1: Attachment): Trail
	local t = Instance.new("Trail")
	t.Name = name
	t.Attachment0 = a0
	t.Attachment1 = a1
	t.Lifetime = 0.22
	t.MinLength = 0.05
	t.LightEmission = 1
	t.LightInfluence = 0
	t.Color = ColorSequence.new(Config.Colors.Charged, Config.Colors.GlowDeep)
	t.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.15),
		NumberSequenceKeypoint.new(1, 1),
	})
	t.WidthScale = NumberSequence.new(1, 0.15)
	t.Enabled = false
	t.Parent = a0.Parent
	return t
end

-- Returns the BowHandle. Safe to call more than once.
function BowAssembly.assemble(tool: Tool): BasePart
	local existing = tool:FindFirstChild("BowHandle")
	if existing and existing:IsA("BasePart") and tool:GetAttribute("LunarBowAssembled") then
		return existing
	end
	local scale = Config.BowScale

	local handle = Instance.new("Part")
	handle.Name = "BowHandle"
	handle.Size = Vector3.one * 0.2
	handle.Transparency = 1
	quiet(handle)
	handle.CFrame = CFrame.new(0, 50, 0)
	handle.Parent = tool

	local folder = tool:FindFirstChild("BowModel") or tool
	local found = 0
	for _, name in BowAssembly.MeshNames do
		local part = findPart(folder, name)
		local info = (Layout.Parts :: any)[name]
		if part and info then
			found += 1
			for _, old in part:GetChildren() do
				if old:IsA("JointInstance") or old:IsA("WeldConstraint") then
					old:Destroy()
				end
			end
			quiet(part)
			part.Size = info.Size * scale
			weld(handle, part, CFrame.new(info.Center * scale))
			style(name, part)
			part.Name = name
		end
	end
	if found == 0 then
		if Config.ShowPlaceholderIfMeshesMissing then
			warn("[LunarBow] Meshes not found in the Tool; using a placeholder. See README (Importar el modelo).")
			buildPlaceholder(handle, folder, scale)
		end
	elseif found < #BowAssembly.MeshNames then
		warn(("[LunarBow] Only %d/%d bow meshes were found in the Tool."):format(found, #BowAssembly.MeshNames))
	end

	-- named points
	local pts: { [string]: Attachment } = {}
	for name, pos in Layout.Points :: { [string]: Vector3 } do
		pts[name] = attachment(handle, name, pos * scale)
	end
	local nock = attachment(handle, "StringNock", Layout.Points.StringRest * scale)

	-- string: a crisp core + a soft halo
	beam("StringUpper", pts.StringTop, nock, 0.045 * scale, 0)
	beam("StringLower", nock, pts.StringBottom, 0.045 * scale, 0)
	beam("StringGlowUpper", pts.StringTop, nock, 0.3 * scale, 0.82)
	beam("StringGlowLower", nock, pts.StringBottom, 0.3 * scale, 0.82)

	local light = Instance.new("PointLight")
	light.Name = "CoreLight"
	light.Color = Config.Colors.Glow
	light.Range = 8 * scale
	light.Brightness = 1.2
	light.Shadows = false
	light.Parent = pts.CoreLight

	-- drifting motes around the limbs
	local motesHost: Instance = findPart(folder, "Limbs") or handle
	local motes = Instance.new("ParticleEmitter")
	motes.Name = "Motes"
	motes.Texture = BowAssembly.SparkleTexture
	motes.Rate = 6
	motes.Lifetime = NumberRange.new(0.8, 1.6)
	motes.Speed = NumberRange.new(0.2, 0.6)
	motes.SpreadAngle = Vector2.new(180, 180)
	motes.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.2 * scale),
		NumberSequenceKeypoint.new(1, 0),
	})
	motes.Transparency = NumberSequence.new(0.1, 1)
	motes.LightEmission = 1
	motes.LightInfluence = 0
	motes.Color = ColorSequence.new(Config.Colors.Glow)
	motes.Rotation = NumberRange.new(0, 360)
	motes.RotSpeed = NumberRange.new(-90, 90)
	motes.Parent = motesHost

	-- burst used by summon / release / dismiss
	local burst = Instance.new("ParticleEmitter")
	burst.Name = "Burst"
	burst.Texture = BowAssembly.SparkleTexture
	burst.Enabled = false
	burst.Lifetime = NumberRange.new(0.3, 0.7)
	burst.Speed = NumberRange.new(5, 12)
	burst.SpreadAngle = Vector2.new(180, 180)
	burst.Drag = 4
	burst.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.45 * scale),
		NumberSequenceKeypoint.new(1, 0),
	})
	burst.Transparency = NumberSequence.new(0, 1)
	burst.LightEmission = 1
	burst.Color = ColorSequence.new(Config.Colors.Charged, Config.Colors.Glow)
	burst.Parent = pts.CoreLight

	trail("TrailTop", pts.TipTopA, pts.TipTopB)
	trail("TrailBottom", pts.TipBottomA, pts.TipBottomB)

	tool.RequiresHandle = false
	tool.CanBeDropped = false
	tool:SetAttribute("Hooked", false)
	tool:SetAttribute("DrawStart", 0)
	tool:SetAttribute("LunarBowAssembled", true)
	CollectionService:AddTag(tool, BowAssembly.Tag)
	return handle
end

-- Motor6D that puts the bow in the left hand. Its Part1 is named "BowHandle",
-- which is what the animations key to spin/tilt the bow.
function BowAssembly.attachToHand(tool: Tool, character: Model): Motor6D?
	local handle = tool:FindFirstChild("BowHandle")
	local hand = character:FindFirstChild("LeftHand")
	if not (handle and handle:IsA("BasePart") and hand and hand:IsA("BasePart")) then
		warn("[LunarBow] The Lunar Bow needs an R15 character (LeftHand not found).")
		return nil
	end
	local old = handle:FindFirstChild("BowGrip")
	if old then
		old:Destroy()
	end
	local gripPos = Vector3.new(0, -0.1, 0)
	local gripAtt = hand:FindFirstChild("LeftGripAttachment")
	if gripAtt and gripAtt:IsA("Attachment") then
		gripPos = Vector3.new(0, gripAtt.Position.Y * 0.67, 0)
	end
	local motor = Instance.new("Motor6D")
	motor.Name = "BowGrip"
	motor.Part0 = hand
	motor.Part1 = handle
	-- bow +Y (upper tip) = hand -Z, bow +Z (string) = hand +Y
	motor.C0 = CFrame.new(gripPos) * CFrame.Angles(-math.pi / 2, 0, 0)
	motor.C1 = CFrame.identity
	motor.Parent = handle
	return motor
end

return BowAssembly
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">BowLayout</string>
          <string name="Source"><![CDATA[--!strict
-- AUTO-GENERATED by tools/build_bow.py. Do not edit by hand.
-- Geometry layout of the Lunar Bow in bow space (studs, origin = hand grip).
-- +Y = upper tip, +Z = string side (toward the archer), +X = lateral.

local BowLayout = {}

-- Bounding-box centre/size of every imported MeshPart (a MeshPart's pivot is its box centre).
BowLayout.Parts = {
	Limbs = { Center = Vector3.new(0.00000, 0.00000, 0.17256), Size = Vector3.new(0.30268, 4.36845, 0.90992) },
	Armor = { Center = Vector3.new(0.00000, 0.00000, 0.08736), Size = Vector3.new(0.35877, 4.92030, 1.38569) },
	Grip = { Center = Vector3.new(0.00000, 0.00010, -0.01187), Size = Vector3.new(0.31325, 0.50206, 0.41947) },
	Crystals = { Center = Vector3.new(0.00000, 0.00000, 0.16564), Size = Vector3.new(0.35199, 4.51894, 0.94894) },
	Aura = { Center = Vector3.new(-0.00006, 0.09060, 0.14175), Size = Vector3.new(1.23698, 4.29231, 1.40648) },
	LunarArrow = { Center = Vector3.new(0.00000, 0.02990, -1.27000), Size = Vector3.new(0.34383, 0.20020, 2.64000) },
}

-- Named points used for the string, trails, lights and arrow.
BowLayout.Points = {
	StringTop = Vector3.new(0.00000, 2.10680, 0.64400),
	TipTopA = Vector3.new(0.00000, 2.45640, 0.46000),
	TipTopB = Vector3.new(0.00000, 1.69467, 0.20252),
	StringBottom = Vector3.new(0.00000, -2.10680, 0.64400),
	TipBottomA = Vector3.new(0.00000, -2.45640, 0.46000),
	TipBottomB = Vector3.new(0.00000, -1.69467, 0.20252),
	StringRest = Vector3.new(0.00000, 0.27600, 0.64400),
	ArrowRest = Vector3.new(-0.15640, 0.27600, 0.01840),
	CoreLight = Vector3.new(0.00000, 0.29487, -0.27941),
	Grip = Vector3.new(0.00000, 0.00000, 0.00000),
}

-- Limb centreline (used to build a primitive placeholder before the meshes are imported).
BowLayout.Centerline = {
	{ Position = Vector3.new(0.00000, -2.13086, 0.57553), Radius = 0.0644 },
	{ Position = Vector3.new(0.00000, -1.97832, 0.42350), Radius = 0.0671 },
	{ Position = Vector3.new(0.00000, -1.81254, 0.28612), Radius = 0.0734 },
	{ Position = Vector3.new(0.00000, -1.63542, 0.16366), Radius = 0.0823 },
	{ Position = Vector3.new(0.00000, -1.45105, 0.05233), Radius = 0.0926 },
	{ Position = Vector3.new(0.00000, -1.25996, -0.04688), Radius = 0.1032 },
	{ Position = Vector3.new(0.00000, -1.05685, -0.11770), Radius = 0.1128 },
	{ Position = Vector3.new(0.00000, -0.84410, -0.14894), Radius = 0.1204 },
	{ Position = Vector3.new(0.00000, -0.62915, -0.13963), Radius = 0.1260 },
	{ Position = Vector3.new(0.00000, -0.41708, -0.10251), Radius = 0.1405 },
	{ Position = Vector3.new(0.00000, -0.21009, -0.04327), Radius = 0.1545 },
	{ Position = Vector3.new(0.00000, 0.00000, -0.00000), Radius = 0.1564 },
	{ Position = Vector3.new(0.00000, 0.21009, -0.04327), Radius = 0.1545 },
	{ Position = Vector3.new(0.00000, 0.41708, -0.10251), Radius = 0.1405 },
	{ Position = Vector3.new(0.00000, 0.62915, -0.13963), Radius = 0.1260 },
	{ Position = Vector3.new(0.00000, 0.84410, -0.14894), Radius = 0.1204 },
	{ Position = Vector3.new(0.00000, 1.05685, -0.11770), Radius = 0.1128 },
	{ Position = Vector3.new(0.00000, 1.25996, -0.04688), Radius = 0.1032 },
	{ Position = Vector3.new(0.00000, 1.45105, 0.05233), Radius = 0.0926 },
	{ Position = Vector3.new(0.00000, 1.63542, 0.16366), Radius = 0.0823 },
	{ Position = Vector3.new(0.00000, 1.81254, 0.28612), Radius = 0.0734 },
	{ Position = Vector3.new(0.00000, 1.97832, 0.42350), Radius = 0.0671 },
	{ Position = Vector3.new(0.00000, 2.13086, 0.57553), Radius = 0.0644 },
}

-- Arrow mesh: its tail (nock) sits this far behind the box centre along +Z.
BowLayout.ArrowLength = 2.64000
BowLayout.ArrowTailOffset = -1.27000

return BowLayout
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">BowVFX</string>
          <string name="Source"><![CDATA[--!strict
-- Client-side visuals for the Lunar Bow: the living string, the nocked arrow,
-- aura/charge glow, projectiles, impacts, summon and dismiss effects.
-- Everything here is cosmetic and runs on every client.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")
local Debris = game:GetService("Debris")

local Config = require(script.Parent.Config)
local Layout = require(script.Parent.BowLayout)

local BowVFX = {}

local SPARKLE = "rbxasset://textures/particles/sparkles_main.dds"
local BOW_PARTS = { "Limbs", "Armor", "Grip", "Crystals", "Aura" }

local folder: Folder? = nil
function BowVFX.effectsFolder(): Folder
	if folder and folder.Parent then
		return folder
	end
	local f = Workspace:FindFirstChild("LunarBowEffects")
	if not (f and f:IsA("Folder")) then
		local nf = Instance.new("Folder")
		nf.Name = "LunarBowEffects"
		nf.Parent = Workspace
		f = nf
	end
	folder = f :: Folder
	return f :: Folder
end

local function tween(inst: Instance, t: number, props: { [string]: any }, style: Enum.EasingStyle?, dir: Enum.EasingDirection?)
	local tw = TweenService:Create(inst, TweenInfo.new(t, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
	tw:Play()
	return tw
end

local function fxPart(shape: Enum.PartType?): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Material = Enum.Material.Neon
	p.Color = Config.Colors.Glow
	if shape then
		p.Shape = shape
	end
	return p
end

local function sparkleEmitter(parent: Instance, size: number, speed: number, color: Color3?): ParticleEmitter
	local e = Instance.new("ParticleEmitter")
	e.Texture = SPARKLE
	e.Enabled = false
	e.Lifetime = NumberRange.new(0.25, 0.6)
	e.Speed = NumberRange.new(speed * 0.5, speed)
	e.SpreadAngle = Vector2.new(180, 180)
	e.Drag = 5
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, size), NumberSequenceKeypoint.new(1, 0) })
	e.Transparency = NumberSequence.new(0, 1)
	e.LightEmission = 1
	e.LightInfluence = 0
	e.Rotation = NumberRange.new(0, 360)
	e.Color = ColorSequence.new(color or Config.Colors.Charged, Config.Colors.Glow)
	e.Parent = parent
	return e
end

-- ---------------------------------------------------------------------------
-- arrows
-- ---------------------------------------------------------------------------
local KIND_SCALE: { [string]: number } = { normal = 1, charged = 1.45, special = 1.1 }

function BowVFX.makeArrow(kind: string): BasePart
	local s = Config.BowScale * (KIND_SCALE[kind] or 1)
	local assets = ReplicatedStorage:FindFirstChild("LunarBowShared")
	assets = assets and assets:FindFirstChild("Assets")
	local template = assets and assets:FindFirstChild("LunarArrow")
	local arrow: BasePart
	if template and template:IsA("BasePart") then
		arrow = template:Clone()
		arrow.Size = Layout.Parts.LunarArrow.Size * s
	else
		arrow = fxPart()
		arrow.Size = Vector3.new(0.07, 0.07, Layout.ArrowLength) * s
	end
	arrow.Name = "LunarArrow"
	arrow.Anchored = true
	arrow.CanCollide = false
	arrow.CanQuery = false
	arrow.CanTouch = false
	arrow.CastShadow = false
	arrow.Material = Enum.Material.Neon
	arrow.Color = if kind == "charged" then Config.Colors.Charged else Config.Colors.Glow
	arrow:SetAttribute("Scale", s)
	return arrow
end

-- CFrame for an arrow whose tail sits at `tail` and flies toward `dir`.
function BowVFX.arrowCFrame(arrow: BasePart, tail: Vector3, dir: Vector3): CFrame
	local s = (arrow:GetAttribute("Scale") :: number?) or 1
	local center = Layout.Parts.LunarArrow.Center * s
	return CFrame.lookAt(tail, tail + dir) * CFrame.new(center)
end

local function addArrowTrail(arrow: BasePart, kind: string)
	local s = (arrow:GetAttribute("Scale") :: number?) or 1
	local a0 = Instance.new("Attachment")
	a0.Position = Vector3.new(0, 0.07 * s, -Layout.ArrowTailOffset * s)
	a0.Parent = arrow
	local a1 = Instance.new("Attachment")
	a1.Position = Vector3.new(0, -0.07 * s, -Layout.ArrowTailOffset * s)
	a1.Parent = arrow
	local t = Instance.new("Trail")
	t.Attachment0 = a0
	t.Attachment1 = a1
	t.Lifetime = if kind == "charged" then 0.35 else 0.2
	t.LightEmission = 1
	t.LightInfluence = 0
	t.FaceCamera = true
	t.Color = ColorSequence.new(Config.Colors.Charged, Config.Colors.GlowDeep)
	t.Transparency = NumberSequence.new(0.1, 1)
	t.WidthScale = NumberSequence.new(if kind == "charged" then 2.5 else 1.2, 0)
	t.Parent = arrow
	local light = Instance.new("PointLight")
	light.Color = Config.Colors.Glow
	light.Range = if kind == "charged" then 12 else 7
	light.Brightness = 2
	light.Parent = arrow
	if kind == "charged" then
		local e = sparkleEmitter(a0, 0.35 * s, 2)
		e.Enabled = true
		e.Rate = 60
		e.Lifetime = NumberRange.new(0.2, 0.4)
	end
end

function BowVFX.impact(position: Vector3, normal: Vector3, kind: string)
	local big = kind == "charged"
	local root = fxPart()
	root.Transparency = 1
	root.Size = Vector3.one * 0.1
	root.CFrame = CFrame.new(position)
	root.Parent = BowVFX.effectsFolder()
	local att = Instance.new("Attachment")
	att.Parent = root
	local e = sparkleEmitter(att, if big then 0.8 else 0.45, if big then 26 else 14)
	e:Emit(if big then 60 else 26)
	local light = Instance.new("PointLight")
	light.Color = Config.Colors.Glow
	light.Range = if big then 20 else 10
	light.Brightness = 4
	light.Parent = root
	tween(light, 0.45, { Brightness = 0 })

	-- shockwave disc aligned with the surface
	local ring = fxPart(Enum.PartType.Cylinder)
	ring.Transparency = 0.1
	ring.Size = Vector3.new(0.08, 0.4, 0.4)
	ring.CFrame = CFrame.lookAt(position, position + normal) * CFrame.Angles(0, math.rad(90), 0)
	ring.Parent = root
	local r = if big then 11 else 5
	tween(ring, if big then 0.45 else 0.3, { Size = Vector3.new(0.04, r, r), Transparency = 1 })

	local flash = fxPart(Enum.PartType.Ball)
	flash.Color = Config.Colors.Charged
	flash.Size = Vector3.one * (if big then 1.2 else 0.6)
	flash.CFrame = CFrame.new(position)
	flash.Parent = root
	tween(flash, 0.25, { Size = Vector3.one * (if big then 4.5 else 2.2), Transparency = 1 })
	Debris:AddItem(root, 1.2)
end

-- Visual projectile from `origin` to `target`; calls impact at the end.
function BowVFX.fireArrow(origin: Vector3, target: Vector3, kind: string, hitNormal: Vector3?)
	local delta = target - origin
	local dist = delta.Magnitude
	if dist < 0.1 then
		return
	end
	local dir = delta / dist
	local speed = (Config.ArrowSpeed :: { [string]: number })[kind] or 300
	local arrow = BowVFX.makeArrow(kind)
	arrow.CFrame = BowVFX.arrowCFrame(arrow, origin, dir)
	arrow.Parent = BowVFX.effectsFolder()
	addArrowTrail(arrow, kind)
	local traveled = 0
	local conn: RBXScriptConnection
	conn = RunService.Heartbeat:Connect(function(dt: number)
		traveled = math.min(dist, traveled + speed * dt)
		arrow.CFrame = BowVFX.arrowCFrame(arrow, origin + dir * traveled, dir)
		if traveled >= dist then
			conn:Disconnect()
			arrow.Transparency = 1
			for _, d in arrow:GetDescendants() do
				if d:IsA("ParticleEmitter") then
					d.Enabled = false
				end
			end
			Debris:AddItem(arrow, 0.5)
			BowVFX.impact(target, hitNormal or -dir, kind)
		end
	end)
end

-- ---------------------------------------------------------------------------
-- bow helpers
-- ---------------------------------------------------------------------------
local function bowParts(tool: Instance): { BasePart }
	local out = {}
	for _, d in tool:GetDescendants() do
		if d:IsA("BasePart") and d.Name ~= "BowHandle" then
			table.insert(out, d)
		end
	end
	return out
end

function BowVFX.setTrails(tool: Instance, enabled: boolean)
	for _, d in tool:GetDescendants() do
		if d:IsA("Trail") then
			d.Enabled = enabled
		end
	end
end

function BowVFX.burst(tool: Instance, count: number)
	local handle = tool:FindFirstChild("BowHandle")
	local core = handle and handle:FindFirstChild("CoreLight")
	local e = core and core:FindFirstChild("Burst")
	if e and e:IsA("ParticleEmitter") then
		e:Emit(count)
	end
end

function BowVFX.hideBow(tool: Instance)
	for _, p in bowParts(tool) do
		p.LocalTransparencyModifier = 1
	end
end

-- "Summon": the bow condenses out of moonlight.
function BowVFX.summon(tool: Instance)
	local parts = bowParts(tool)
	local t0 = os.clock()
	local conn: RBXScriptConnection
	conn = RunService.RenderStepped:Connect(function()
		local a = math.clamp((os.clock() - t0) / 0.35, 0, 1)
		for _, p in parts do
			if p.Parent then
				p.LocalTransparencyModifier = 1 - a * a
			end
		end
		if a >= 1 then
			conn:Disconnect()
		end
	end)
	BowVFX.burst(tool, 40)
	BowVFX.setTrails(tool, true)
	task.delay(0.9, function()
		if tool.Parent then
			BowVFX.setTrails(tool, false)
		end
	end)
end

-- "Dismiss": a ghost of the bow floats up and dissolves (tool may already be in the Backpack).
function BowVFX.dismiss(tool: Instance?, handleCFrame: CFrame)
	local root = fxPart()
	root.Transparency = 1
	root.Size = Vector3.one * 0.1
	root.CFrame = handleCFrame
	root.Parent = BowVFX.effectsFolder()
	local att = Instance.new("Attachment")
	att.Parent = root
	sparkleEmitter(att, 0.4, 8):Emit(45)
	if tool then
		local handle = tool:FindFirstChild("BowHandle")
		for _, name in BOW_PARTS do
			local src = tool:FindFirstChild(name, true)
			local w = src and src:FindFirstChild("BowWeld")
			if src and src:IsA("BasePart") and w and w:IsA("Weld") and handle then
				local ghost = src:Clone()
				ghost:ClearAllChildren()
				local sa = src:FindFirstChildOfClass("SurfaceAppearance")
				if sa then
					sa:Clone().Parent = ghost
				end
				ghost.Anchored = true
				ghost.LocalTransparencyModifier = 0
				ghost.CFrame = handleCFrame * w.C0
				ghost.Parent = root
				tween(ghost, 0.55, {
					CFrame = ghost.CFrame + Vector3.new(0, 1.6, 0),
					Transparency = 1,
				}, Enum.EasingStyle.Sine, Enum.EasingDirection.In)
			end
		end
	end
	Debris:AddItem(root, 1)
end

function BowVFX.landing(position: Vector3)
	local ring = fxPart(Enum.PartType.Cylinder)
	ring.Color = Config.Colors.Glow
	ring.Transparency = 0.2
	ring.Size = Vector3.new(0.06, 1, 1)
	ring.CFrame = CFrame.new(position) * CFrame.Angles(0, 0, math.rad(90))
	ring.Parent = BowVFX.effectsFolder()
	tween(ring, 0.4, { Size = Vector3.new(0.03, 12, 12), Transparency = 1 })
	local att = Instance.new("Attachment")
	att.Parent = ring
	sparkleEmitter(att, 0.35, 10):Emit(30)
	Debris:AddItem(ring, 0.8)
end

-- ---------------------------------------------------------------------------
-- per-bow live visuals: string spring, nocked arrow, aura charge
-- ---------------------------------------------------------------------------
type Tracker = { update: (dt: number) -> (), destroy: () -> () }

function BowVFX.trackBow(tool: Tool): Tracker?
	local handle = tool:FindFirstChild("BowHandle")
	if not (handle and handle:IsA("BasePart")) then
		return nil
	end
	local nock = handle:FindFirstChild("StringNock") :: Attachment?
	local rest = handle:FindFirstChild("StringRest") :: Attachment?
	local arrowRest = handle:FindFirstChild("ArrowRest") :: Attachment?
	local coreAtt = handle:FindFirstChild("CoreLight")
	local light = coreAtt and coreAtt:FindFirstChildOfClass("PointLight")
	local aura = tool:FindFirstChild("Aura", true) :: BasePart?
	local crystals = tool:FindFirstChild("Crystals", true) :: BasePart?
	if not (nock and rest and arrowRest) then
		return nil
	end

	local pos = rest.Position
	local vel = Vector3.zero
	local wasHooked = false
	local arrow: BasePart? = nil

	local function update(dt: number)
		dt = math.min(dt, 1 / 30)
		local character = tool.Parent
		local hooked = tool:GetAttribute("Hooked") == true and character ~= nil and character:IsA("Model")
		local target = rest.Position
		if hooked and character then
			local hand = character:FindFirstChild("RightHand")
			if hand and hand:IsA("BasePart") then
				local grip = hand:FindFirstChild("RightGripAttachment")
				local world = if grip and grip:IsA("Attachment")
					then grip.WorldPosition
					else (hand.CFrame * CFrame.new(0, -0.15, 0)).Position
				target = handle.CFrame:PointToObjectSpace(world)
			end
		end
		-- stiff while held, loose & bouncy ("twang") once released
		local k, c = if hooked then 2200 else 950, if hooked then 90 else 13
		if hooked and not wasHooked then
			vel = Vector3.zero
		end
		vel += ((target - pos) * k - vel * c) * dt
		pos += vel * dt
		nock.Position = pos
		wasHooked = hooked

		-- the arrow sits on the string while it is hooked
		if hooked then
			if not arrow then
				local a = BowVFX.makeArrow("normal")
				a.Parent = BowVFX.effectsFolder()
				arrow = a
			end
			local tail = nock.WorldPosition
			local dir = (arrowRest.WorldPosition - tail)
			if dir.Magnitude > 0.05 then
				(arrow :: BasePart).CFrame = BowVFX.arrowCFrame(arrow :: BasePart, tail, dir.Unit)
			end
		elseif arrow then
			arrow:Destroy()
			arrow = nil
		end

		-- charge glow (DrawStart is a server time stamp)
		local charge = 0
		local start = tool:GetAttribute("DrawStart") :: number?
		if hooked and start and start > 0 then
			charge = math.clamp((Workspace:GetServerTimeNow() - start - 0.45) / Config.ChargeTime, 0, 1)
		end
		if aura then
			local target_t = Config.AuraIdleTransparency
				+ (Config.AuraChargedTransparency - Config.AuraIdleTransparency) * charge
			aura.Transparency += (target_t - aura.Transparency) * math.min(1, dt * 10)
		end
		if light then
			light.Brightness = 1.2 + charge * 2.5 + (if charge >= 1 then math.sin(os.clock() * 18) * 0.8 else 0)
		end
		if crystals then
			local pulse = if charge >= 1 then 0.5 + 0.5 * math.sin(os.clock() * 18) else charge * 0.4
			crystals.Color = Config.Colors.Glow:Lerp(Config.Colors.Charged, pulse)
		end
		if arrow then
			arrow.Color = if charge >= 1 then Config.Colors.Charged else Config.Colors.Glow
		end
	end

	local function destroy()
		if arrow then
			arrow:Destroy()
			arrow = nil
		end
	end

	return { update = update, destroy = destroy }
end

-- The local player's character is excluded from aim raycasts together with effects.
function BowVFX.raycastParams(extra: { Instance }?): RaycastParams
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local list: { Instance } = { BowVFX.effectsFolder() }
	local lp = Players.LocalPlayer
	if lp and lp.Character then
		table.insert(list, lp.Character)
	end
	if extra then
		for _, i in extra do
			table.insert(list, i)
		end
	end
	params.FilterDescendantsInstances = list
	return params
end

return BowVFX
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[--!strict
-- Arco Lunar / Lunar Bow — settings shared by server and client.

local Config = {}

-- Size multiplier over the authored bow (≈4.5 studs tip to tip at 1).
Config.BowScale = 1

-- Published animation asset ids. Leave a value empty ("") to use the built-in
-- keyframe player instead (works in Studio and in live games without uploading
-- anything). To use Roblox's own Animator, import the .rbxmx files from
-- /animations, publish them from the Animation Editor and paste the ids here,
-- e.g. Hold = "rbxassetid://1234567890".
Config.AnimationIds = {
	Hold = "",
	Equip = "",
	Draw = "",
	Aim = "",
	AimStance = "",
	Shoot = "",
	ShootCharged = "",
	Special = "",
	Unequip = "",
}

-- Optional: ColorMap image ids used as MeshPart.TextureID when a part has no
-- SurfaceAppearance (SurfaceAppearance maps can only be set from Studio).
Config.TextureIds = {
	Limbs = "",
	Armor = "",
	Grip = "",
}

-- Combat ---------------------------------------------------------------------
Config.Damage = {
	normal = 22,
	charged = 55,
	special = 20, -- per arrow
}
Config.ArrowSpeed = {
	normal = 280,
	charged = 380,
	special = 300,
}
Config.Range = 500
Config.FireCooldown = 0.28 -- seconds between shots
Config.ChargeTime = 0.9 -- seconds at full draw to get a charged shot
Config.SpecialCooldown = 6
Config.SpecialArrows = 3
Config.SpecialSpread = 6 -- degrees between special arrows
Config.TeamCheck = true -- don't damage players on the same (non-neutral) team

-- Special move ("Salto Lunar") jump arc
Config.SpecialJumpHeight = 8
Config.SpecialJumpBack = 14 -- studs travelled backwards

-- Feel -----------------------------------------------------------------------
Config.AimWalkSpeedMultiplier = 0.55
Config.AimFieldOfView = 60
Config.AimCameraOffset = Vector3.new(1.4, 0.35, 0)
Config.SpecialKeys = { Enum.KeyCode.Q, Enum.KeyCode.ButtonY }

-- Look -----------------------------------------------------------------------
Config.Colors = {
	Glow = Color3.fromRGB(90, 215, 255),
	GlowDeep = Color3.fromRGB(30, 110, 255),
	Charged = Color3.fromRGB(190, 245, 255),
	Body = Color3.fromRGB(28, 34, 58),
	Gold = Color3.fromRGB(214, 186, 128),
	Grip = Color3.fromRGB(30, 32, 46),
}
Config.AuraIdleTransparency = 0.82 -- 1 = hidden
Config.AuraChargedTransparency = 0.15
Config.ShowPlaceholderIfMeshesMissing = true

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="RemoteEvent" referent="12">
        <Properties>
          <string name="Name">FX</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">KeyframePlayer</string>
          <string name="Source"><![CDATA[--!strict
-- Built-in keyframe player.
--
-- Plays the data in BowAnimationData on any R15 rig by writing Motor6D.Transform
-- in RunService.PreSimulation, i.e. right after Roblox's Animator has run. It
-- blends on top of whatever the Animator produced (walk, jump...), respects
-- priorities, fades, speed, looping and KeyframeMarkers, so it behaves like an
-- AnimationTrack without having to publish the animations first.

local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Data = require(script.Parent.BowAnimationData)
local Signal = require(script.Parent.Signal)

type AnimationData = Data.AnimationData

local PRIORITY: { [string]: number } = {
	Core = 0,
	Idle = 1,
	Movement = 2,
	Action = 3,
	Action2 = 4,
	Action3 = 5,
	Action4 = 6,
}
local STYLE: { [string]: Enum.EasingStyle } = {
	CubicV2 = Enum.EasingStyle.Cubic,
	Cubic = Enum.EasingStyle.Cubic,
	Elastic = Enum.EasingStyle.Elastic,
	Bounce = Enum.EasingStyle.Bounce,
}
local DIRECTION: { [string]: Enum.EasingDirection } = {
	In = Enum.EasingDirection.In,
	Out = Enum.EasingDirection.Out,
	InOut = Enum.EasingDirection.InOut,
}

export type Track = {
	Name: string,
	Data: AnimationData,
	Looped: boolean,
	Length: number,
	TimePosition: number,
	Speed: number,
	Weight: number,
	Stopped: Signal.Signal,
	Play: (self: Track, fadeTime: number?, weight: number?, speed: number?) -> (),
	Stop: (self: Track, fadeTime: number?) -> (),
	AdjustSpeed: (self: Track, speed: number) -> (),
	IsPlaying: (self: Track) -> boolean,
	GetMarkerReachedSignal: (self: Track, name: string) -> Signal.Signal,
	Destroy: (self: Track) -> (),
}

type TrackState = {
	track: Track,
	fade: number,
	fadeTarget: number,
	fadeRate: number,
	active: boolean,
	stopping: boolean,
	order: number,
	markers: { [string]: Signal.Signal },
}

type Rig = {
	character: Model,
	humanoid: Humanoid?,
	motors: { [string]: Motor6D },
	states: { TrackState },
	written: { [Motor6D]: CFrame },
	connections: { RBXScriptConnection },
}

local KeyframePlayer = {}

local rigs: { [Model]: Rig } = {}
local playCounter = 0
local stepConnection: RBXScriptConnection? = nil

local function ease(alpha: number, style: string, direction: string): number
	if style == "Linear" then
		return alpha
	elseif style == "Constant" then
		return 0
	end
	return TweenService:GetValue(alpha, STYLE[style] or Enum.EasingStyle.Cubic, DIRECTION[direction] or Enum.EasingDirection.Out)
end

local function refreshMotors(rig: Rig)
	table.clear(rig.motors)
	for _, d in rig.character:GetDescendants() do
		if d:IsA("Motor6D") and d.Part1 then
			rig.motors[(d.Part1 :: BasePart).Name] = d
		end
	end
end

local function sampleJoint(data: AnimationData, joint: string, t: number, scale: number): CFrame?
	local keys = data.Keyframes
	local n = #keys
	local a = keys[1]
	if t <= a.Time or n == 1 then
		local cf = a.Poses[joint]
		return cf and (cf - cf.Position + cf.Position * scale)
	end
	for i = 1, n - 1 do
		local k0, k1 = keys[i], keys[i + 1]
		if t < k1.Time then
			local p0, p1 = k0.Poses[joint], k1.Poses[joint]
			if not p0 or not p1 then
				return p0 or p1
			end
			local alpha = ease((t - k0.Time) / (k1.Time - k0.Time), k0.Style, k0.Direction)
			local cf = p0:Lerp(p1, alpha)
			return cf - cf.Position + cf.Position * scale
		end
	end
	local cf = keys[n].Poses[joint]
	return cf and (cf - cf.Position + cf.Position * scale)
end

local function fireMarkers(state: TrackState, from: number, to: number)
	-- fires markers whose keyframe time lies in (from, to]
	for _, key in state.track.Data.Keyframes do
		if key.Time > from and key.Time <= to then
			for _, marker in key.Markers do
				local sig = state.markers[marker[1]]
				if sig then
					sig:Fire(marker[2])
				end
			end
		end
	end
end

local function stepRig(rig: Rig, dt: number)
	local scale = 1
	local humanoid = rig.humanoid
	if humanoid and humanoid.RigType == Enum.HumanoidRigType.R15 and humanoid.HipHeight > 0 then
		scale = humanoid.HipHeight / 2
	end

	-- advance time, markers and fades
	for i = #rig.states, 1, -1 do
		local s = rig.states[i]
		local tr = s.track
		local length = tr.Length
		local prev = tr.TimePosition
		local now = prev + dt * tr.Speed
		if tr.Looped and length > 0 then
			if now >= length then
				fireMarkers(s, prev, length)
				now = now % length
				fireMarkers(s, -1, now)
			else
				fireMarkers(s, prev, now)
			end
		else
			fireMarkers(s, prev, math.min(now, length))
			if now >= length then
				now = length
				if not s.stopping then
					tr:Stop(0.12)
				end
			end
		end
		tr.TimePosition = now

		if s.fade < s.fadeTarget then
			s.fade = math.min(s.fadeTarget, s.fade + s.fadeRate * dt)
		elseif s.fade > s.fadeTarget then
			s.fade = math.max(s.fadeTarget, s.fade - s.fadeRate * dt)
		end
		if s.stopping and s.fade <= 0 then
			s.active = false
			table.remove(rig.states, i)
		end
	end

	-- blend: lowest priority first, so higher priorities override
	table.sort(rig.states, function(a: TrackState, b: TrackState)
		local pa, pb = PRIORITY[a.track.Data.Priority] or 0, PRIORITY[b.track.Data.Priority] or 0
		if pa == pb then
			return a.order < b.order
		end
		return pa < pb
	end)

	local driven: { [Motor6D]: CFrame } = {}
	for _, s in rig.states do
		local w = s.fade * s.track.Weight
		if w > 0.001 then
			for _, joint in s.track.Data.Joints do
				local motor = rig.motors[joint]
				if motor then
					local pose = sampleJoint(s.track.Data, joint, s.track.TimePosition, scale)
					if pose then
						local base = driven[motor]
						if not base then
							local current = motor.Transform
							-- if nobody touched it since our last write, the rest pose is identity
							base = if rig.written[motor] == current then CFrame.identity else current
						end
						driven[motor] = (base :: CFrame):Lerp(pose, math.min(w, 1))
					end
				end
			end
		end
	end

	for motor, cf in driven do
		motor.Transform = cf
	end
	for motor, last in rig.written do
		if not driven[motor] then
			if motor.Parent and motor.Transform == last then
				motor.Transform = CFrame.identity
			end
			rig.written[motor] = nil
		end
	end
	for motor, cf in driven do
		rig.written[motor] = cf
	end
end

local function ensureStepping()
	if stepConnection then
		return
	end
	stepConnection = RunService.PreSimulation:Connect(function(dt: number)
		for character, rig in rigs do
			if not character.Parent then
				KeyframePlayer.releaseRig(character)
			elseif #rig.states > 0 or next(rig.written) then
				stepRig(rig, dt)
			end
		end
	end)
end

local function getRig(character: Model): Rig
	local rig = rigs[character]
	if rig then
		return rig
	end
	local newRig: Rig = {
		character = character,
		humanoid = character:FindFirstChildOfClass("Humanoid"),
		motors = {},
		states = {},
		written = {},
		connections = {},
	}
	refreshMotors(newRig)
	local function onChanged(d: Instance)
		if d:IsA("Motor6D") then
			task.defer(refreshMotors, newRig)
		end
	end
	table.insert(newRig.connections, character.DescendantAdded:Connect(onChanged))
	table.insert(newRig.connections, character.DescendantRemoving:Connect(onChanged))
	rigs[character] = newRig
	ensureStepping()
	return newRig
end

function KeyframePlayer.releaseRig(character: Model)
	local rig = rigs[character]
	if not rig then
		return
	end
	for _, c in rig.connections do
		c:Disconnect()
	end
	rigs[character] = nil
end

function KeyframePlayer.has(name: string): boolean
	return Data[name] ~= nil
end

-- Creates a track for animation `name` on `character`.
function KeyframePlayer.load(character: Model, name: string): Track
	local data = Data[name]
	assert(data, "Unknown Lunar Bow animation: " .. tostring(name))
	local rig = getRig(character)

	local track = {
		Name = name,
		Data = data,
		Looped = data.Loop,
		Length = data.Length,
		TimePosition = 0,
		Speed = 1,
		Weight = 1,
		Stopped = Signal.new(),
	} :: Track
	local state: TrackState = {
		track = track,
		fade = 0,
		fadeTarget = 0,
		fadeRate = 1,
		active = false,
		stopping = false,
		order = 0,
		markers = {},
	}

	function track.Play(self: Track, fadeTime: number?, weight: number?, speed: number?)
		local fade = fadeTime or 0.1
		self.Weight = weight or 1
		self.Speed = speed or 1
		self.TimePosition = 0
		playCounter += 1
		state.order = playCounter
		state.stopping = false
		state.fadeTarget = 1
		state.fadeRate = if fade > 0 then 1 / fade else math.huge
		if not state.active then
			state.active = true
			state.fade = 0
			table.insert(rig.states, state)
		end
		fireMarkers(state, -1, 0)
	end

	function track.Stop(self: Track, fadeTime: number?)
		if not state.active or state.stopping then
			return
		end
		local fade = fadeTime or 0.1
		state.stopping = true
		state.fadeTarget = 0
		state.fadeRate = if fade > 0 then 1 / fade else math.huge
		self.Stopped:Fire()
	end

	function track.AdjustSpeed(self: Track, speed: number)
		self.Speed = speed
	end

	function track.IsPlaying(_: Track): boolean
		return state.active and not state.stopping
	end

	function track.GetMarkerReachedSignal(_: Track, markerName: string): Signal.Signal
		local sig = state.markers[markerName]
		if not sig then
			sig = Signal.new()
			state.markers[markerName] = sig
		end
		return sig :: Signal.Signal
	end

	function track.Destroy(self: Track)
		self:Stop(0)
		self.Stopped:DisconnectAll()
		for _, sig in state.markers do
			sig:DisconnectAll()
		end
	end

	return track
end

return KeyframePlayer
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">Signal</string>
          <string name="Source"><![CDATA[--!strict
-- Minimal signal with the same shape as RBXScriptSignal (Connect / Once / Disconnect).

export type Connection = {
	Connected: boolean,
	Disconnect: (self: Connection) -> (),
}

export type Signal = {
	Connect: (self: Signal, fn: (...any) -> ()) -> Connection,
	Once: (self: Signal, fn: (...any) -> ()) -> Connection,
	Fire: (self: Signal, ...any) -> (),
	DisconnectAll: (self: Signal) -> (),
}

local Signal = {}

function Signal.new(): Signal
	local handlers: { [Connection]: (...any) -> () } = {}
	local self = {} :: Signal

	function self.Connect(_: Signal, fn: (...any) -> ()): Connection
		local conn = { Connected = true } :: Connection
		function conn.Disconnect(c: Connection)
			c.Connected = false
			handlers[c] = nil
		end
		handlers[conn] = fn
		return conn
	end

	function self.Once(s: Signal, fn: (...any) -> ()): Connection
		local conn: Connection
		conn = s:Connect(function(...)
			conn:Disconnect()
			fn(...)
		end)
		return conn
	end

	function self.Fire(_: Signal, ...: any)
		for conn, fn in table.clone(handlers) do
			if conn.Connected then
				task.spawn(fn, ...)
			end
		end
	end

	function self.DisconnectAll(_: Signal)
		for conn in handlers do
			conn.Connected = false
		end
		table.clear(handlers)
	end

	return self
end

return Signal
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="15">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="16">
      <Properties>
        <string name="Name">DemoTargets</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict
-- Demo only: spawns R15 training dummies to shoot at (they respawn when defeated).

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local SPOTS = {
	Vector3.new(-14, 0, -30),
	Vector3.new(0, 0, -45),
	Vector3.new(16, 0, -34),
	Vector3.new(30, 0, -70),
}

local folder = Instance.new("Folder")
folder.Name = "TrainingDummies"
folder.Parent = Workspace

local function spawnDummy(pos: Vector3)
	local desc = Instance.new("HumanoidDescription")
	desc.HeadColor = Color3.fromRGB(200, 205, 220)
	desc.TorsoColor = Color3.fromRGB(60, 70, 110)
	desc.LeftArmColor = desc.HeadColor
	desc.RightArmColor = desc.HeadColor
	desc.LeftLegColor = Color3.fromRGB(40, 45, 70)
	desc.RightLegColor = desc.LeftLegColor
	local dummy = Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15)
	dummy.Name = "Dummy"
	local humanoid = dummy:FindFirstChildOfClass("Humanoid") :: Humanoid
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.Subject
	humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOn
	humanoid.MaxHealth = 150
	humanoid.Health = 150
	dummy:PivotTo(CFrame.lookAt(pos + Vector3.new(0, 3, 0), Vector3.new(0, 3, 20)))
	dummy.Parent = folder
	humanoid.Died:Connect(function()
		task.wait(3)
		dummy:Destroy()
		spawnDummy(pos)
	end)
end

for _, p in SPOTS do
	spawnDummy(p)
end
]]></string>
      </Properties>
    </Item>
  </Item>
  <Item class="StarterPack" referent="17">
    <Properties>
      <string name="Name">StarterPack</string>
    </Properties>
    <Item class="Tool" referent="18">
      <Properties>
        <string name="Name">LunarBow</string>
        <bool name="CanBeDropped">false</bool>
        <bool name="NeedsPivotMigration">false</bool>
        <bool name="RequiresHandle">false</bool>
        <string name="ToolTip">Arco Lunar</string>
      </Properties>
      <Item class="LocalScript" referent="19">
        <Properties>
          <string name="Name">BowClient</string>
          <string name="Source"><![CDATA[--!strict
-- Lunar Bow — local controls (lives inside the Tool).
--
--   Hold click / tap / R2 : draw (the longer you hold at full draw, the stronger)
--   Release               : shoot (charged shot after Config.ChargeTime)
--   Q / ButtonY / button  : "Salto Lunar" special (backflip + triple aerial shot)

local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local tool = script.Parent :: Tool
local player = Players.LocalPlayer
local Shared = ReplicatedStorage:WaitForChild("LunarBowShared")
local Config = require(Shared:WaitForChild("Config"))
local BowAnimator = require(Shared:WaitForChild("BowAnimator"))
local BowVFX = require(Shared:WaitForChild("BowVFX"))
local remote = tool:WaitForChild("BowRemote") :: RemoteEvent

type State = "Off" | "Equipping" | "Idle" | "Drawing" | "Aiming" | "Shooting" | "Special"
type Disconnectable = { Disconnect: (self: any) -> () }

local SPECIAL_ACTION = "LunarBowSpecial"
-- fallback timings (seconds) in case an animation has no markers
local TIMING = {
	Summon = 0.14,
	EquipDone = 0.8,
	Nock = 0.13,
	FullDraw = 0.45,
	Jump = 0.22,
	SpecialDraw = 0.62,
	SpecialRelease = 0.84,
	Land = 1.08,
	SpecialEnd = 1.62,
}

local state: State = "Off"
local anim: BowAnimator.BowAnimator? = nil
local humanoid: Humanoid? = nil
local root: BasePart? = nil
local connections: { Disconnectable } = {}
local actionId = 0
local fired: { [string]: boolean } = {}
local equipAt = 0
local fullDrawAt = 0
local releaseQueued = false
local lastShot = 0
local lastSpecial = -math.huge
local lastHandleCF = CFrame.identity
local baseWalkSpeed = 16
local defaultFov = 70
local aiming = false
local stanceOn = false
local align: AlignOrientation? = nil
local leapConn: RBXScriptConnection? = nil
local leapVelocity: LinearVelocity? = nil
local hud: ScreenGui? = nil
local equipCount = 0

local function now(): number
	return os.clock()
end

-- read through a function so closures never see a stale narrowed type
local function currentState(): State
	return state
end

local function camera(): Camera
	return Workspace.CurrentCamera :: Camera
end

local function tween(inst: Instance, t: number, props: { [string]: any })
	TweenService:Create(inst, TweenInfo.new(t, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props):Play()
end

-- run `fn` once per action, from whichever arrives first: marker or timer
local function trigger(name: string, fn: () -> ())
	if fired[name] then
		return
	end
	fired[name] = true
	fn()
end

local function newAction(): number
	actionId += 1
	table.clear(fired)
	return actionId
end

local function after(id: number, t: number, name: string, fn: () -> ())
	task.delay(t, function()
		if actionId == id then
			trigger(name, fn)
		end
	end)
end

-- ---------------------------------------------------------------------------
-- aiming helpers
-- ---------------------------------------------------------------------------
local function usesScreenCenter(): boolean
	local last = UserInputService:GetLastInputType()
	if last == Enum.UserInputType.Touch or last.Name:find("Gamepad") then
		return true
	end
	return UserInputService.MouseBehavior == Enum.MouseBehavior.LockCenter
end

local function aimScreenPoint(): Vector2
	if usesScreenCenter() then
		return camera().ViewportSize / 2
	end
	return UserInputService:GetMouseLocation()
end

local function aimTarget(): Vector3
	local p = aimScreenPoint()
	local ray = camera():ViewportPointToRay(p.X, p.Y)
	local result = Workspace:Raycast(ray.Origin, ray.Direction * (Config.Range + 60), BowVFX.raycastParams())
	return if result then result.Position else ray.Origin + ray.Direction * Config.Range
end

local function arrowOrigin(): Vector3
	local handle = tool:FindFirstChild("BowHandle")
	local rest = handle and handle:FindFirstChild("ArrowRest")
	if rest and rest:IsA("Attachment") then
		return rest.WorldPosition
	end
	return if root then root.Position else Vector3.zero
end

local function predictHit(origin: Vector3, target: Vector3): (Vector3, Vector3)
	local delta = target - origin
	if delta.Magnitude < 0.01 then
		return target, Vector3.yAxis
	end
	local dir = delta.Unit
	local result = Workspace:Raycast(origin, dir * Config.Range, BowVFX.raycastParams())
	if result then
		return result.Position, result.Normal
	end
	return origin + dir * Config.Range, -dir
end

local function setHooked(hooked: boolean)
	if tool:GetAttribute("Hooked") == hooked then
		return
	end
	tool:SetAttribute("Hooked", hooked)
	tool:SetAttribute("DrawStart", if hooked then Workspace:GetServerTimeNow() else 0)
	remote:FireServer("Hook", hooked)
end

local function setFacing(point: Vector3?)
	if not root then
		return
	end
	if not point then
		if align then
			align:Destroy()
			align = nil
		end
		return
	end
	local pos = root.Position
	local flat = Vector3.new(point.X - pos.X, 0, point.Z - pos.Z)
	if flat.Magnitude < 0.2 then
		return
	end
	if not align then
		local att = root:FindFirstChild("RootAttachment") :: Attachment?
		if not att then
			local a = Instance.new("Attachment")
			a.Name = "RootAttachment"
			a.Parent = root
			att = a
		end
		local ao = Instance.new("AlignOrientation")
		ao.Name = "LunarBowFacing"
		ao.Mode = Enum.OrientationAlignmentMode.OneAttachment
		ao.Attachment0 = att
		ao.MaxTorque = math.huge
		ao.Responsiveness = 45
		ao.Parent = root
		align = ao
	end
	(align :: AlignOrientation).CFrame = CFrame.lookAt(Vector3.zero, flat.Unit)
end

local function setAiming(on: boolean)
	if aiming == on then
		return
	end
	aiming = on
	if humanoid then
		humanoid.AutoRotate = not on
		humanoid.WalkSpeed = if on then baseWalkSpeed * Config.AimWalkSpeedMultiplier else baseWalkSpeed
		tween(humanoid, 0.25, { CameraOffset = if on then Config.AimCameraOffset else Vector3.zero })
	end
	tween(camera(), 0.25, { FieldOfView = if on then Config.AimFieldOfView else defaultFov })
	if not on then
		setFacing(nil)
		if stanceOn and anim then
			anim:Stop("AimStance", 0.2)
		end
		stanceOn = false
	end
end

-- ---------------------------------------------------------------------------
-- HUD (crosshair + charge bar + special cooldown)
-- ---------------------------------------------------------------------------
local function buildHud(): ScreenGui
	local gui = Instance.new("ScreenGui")
	gui.Name = "LunarBowHUD"
	gui.ResetOnSpawn = true
	gui.IgnoreGuiInset = true
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

	local cross = Instance.new("Frame")
	cross.Name = "Crosshair"
	cross.AnchorPoint = Vector2.new(0.5, 0.5)
	cross.Size = UDim2.fromOffset(64, 64)
	cross.BackgroundTransparency = 1
	cross.Parent = gui
	for i, rot in { 0, 90, 180, 270 } do
		local tick = Instance.new("Frame")
		tick.Name = "Tick" .. i
		tick.AnchorPoint = Vector2.new(0.5, 0.5)
		tick.Size = UDim2.fromOffset(2, 9)
		tick.BorderSizePixel = 0
		tick.BackgroundColor3 = Config.Colors.Glow
		tick.Rotation = rot
		tick.Parent = cross
	end
	local dot = Instance.new("Frame")
	dot.Name = "Dot"
	dot.AnchorPoint = Vector2.new(0.5, 0.5)
	dot.Position = UDim2.fromScale(0.5, 0.5)
	dot.Size = UDim2.fromOffset(5, 5)
	dot.Rotation = 45
	dot.BorderSizePixel = 0
	dot.BackgroundColor3 = Color3.new(1, 1, 1)
	dot.Parent = cross

	local bar = Instance.new("Frame")
	bar.Name = "Charge"
	bar.AnchorPoint = Vector2.new(0.5, 0)
	bar.Position = UDim2.new(0.5, 0, 1, 2)
	bar.Size = UDim2.fromOffset(56, 4)
	bar.BackgroundColor3 = Color3.fromRGB(10, 20, 40)
	bar.BackgroundTransparency = 0.3
	bar.BorderSizePixel = 0
	bar.Visible = false
	bar.Parent = cross
	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.Size = UDim2.fromScale(0, 1)
	fill.BorderSizePixel = 0
	fill.BackgroundColor3 = Config.Colors.Glow
	fill.Parent = bar
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(1, 0)
	corner.Parent = bar

	local label = Instance.new("TextLabel")
	label.Name = "Special"
	label.AnchorPoint = Vector2.new(0.5, 1)
	label.Position = UDim2.new(0.5, 0, 1, -110)
	label.Size = UDim2.fromOffset(260, 26)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBold
	label.TextSize = 16
	label.TextColor3 = Config.Colors.Glow
	label.TextStrokeTransparency = 0.5
	label.Text = ""
	label.Parent = gui

	gui.Parent = player:WaitForChild("PlayerGui")
	return gui
end

local function updateHud()
	if not hud then
		return
	end
	local cross = hud:FindFirstChild("Crosshair") :: Frame?
	if not cross then
		return
	end
	local p = aimScreenPoint()
	cross.Position = UDim2.fromOffset(p.X, p.Y)

	local charge = 0
	if state == "Aiming" then
		charge = math.clamp((now() - fullDrawAt) / Config.ChargeTime, 0, 1)
	end
	local drawing = state == "Drawing" or state == "Aiming"
	local spread = if drawing then 14 - 9 * charge else 16
	for i, dir in { Vector2.new(0, -1), Vector2.new(1, 0), Vector2.new(0, 1), Vector2.new(-1, 0) } do
		local tick = cross:FindFirstChild("Tick" .. i) :: Frame?
		if tick then
			tick.Position = UDim2.new(0.5, dir.X * spread, 0.5, dir.Y * spread)
			tick.BackgroundColor3 = if charge >= 1 then Config.Colors.Charged else Config.Colors.Glow
		end
	end
	local bar = cross:FindFirstChild("Charge") :: Frame?
	if bar then
		bar.Visible = drawing
		local fill = bar:FindFirstChild("Fill") :: Frame?
		if fill then
			fill.Size = UDim2.fromScale(charge, 1)
			fill.BackgroundColor3 = if charge >= 1
				then Config.Colors.Charged:Lerp(Color3.new(1, 1, 1), 0.5 + 0.5 * math.sin(now() * 16))
				else Config.Colors.Glow
		end
	end
	local label = hud:FindFirstChild("Special") :: TextLabel?
	if label then
		local left = Config.SpecialCooldown - (now() - lastSpecial)
		label.Text = if left > 0
			then ("Salto Lunar  %.1fs"):format(left)
			else "[" .. Config.SpecialKeys[1].Name .. "]  Salto Lunar"
		label.TextTransparency = if left > 0 then 0.5 else 0
	end
end

-- ---------------------------------------------------------------------------
-- shooting
-- ---------------------------------------------------------------------------
local function fire()
	if state ~= "Aiming" or not anim then
		return
	end
	local charged = now() - fullDrawAt >= Config.ChargeTime
	local kind = if charged then "charged" else "normal"
	newAction()
	state = "Shooting"
	lastShot = now()
	anim:Stop("Aim", 0.05)
	anim:Stop("Draw", 0.05)
	anim:Play(if charged then "ShootCharged" else "Shoot", 0.03)
	setHooked(false)

	local origin = arrowOrigin()
	local target = aimTarget()
	local hit, normal = predictHit(origin, target)
	BowVFX.fireArrow(origin, hit, kind, normal)
	BowVFX.burst(tool, if charged then 34 else 12)
	remote:FireServer("Fire", kind, origin, { target })
	if charged then
		local cam = camera()
		cam.FieldOfView = Config.AimFieldOfView + 6
		tween(cam, 0.3, { FieldOfView = Config.AimFieldOfView })
	end

	local id = actionId
	task.delay(if charged then 0.45 else 0.3, function()
		if actionId == id and currentState() == "Shooting" then
			state = "Idle"
			setAiming(false)
		end
	end)
end

local function enterAim()
	if state ~= "Drawing" or not anim then
		return
	end
	state = "Aiming"
	fullDrawAt = now()
	setHooked(true)
	anim:Play("Aim", 0.12)
	if releaseQueued then
		fire()
	end
end

local function beginDraw()
	if not anim then
		return
	end
	local ready = state == "Idle"
		or (state == "Equipping" and now() - equipAt > 0.5)
		or (state == "Shooting" and now() - lastShot > Config.FireCooldown)
	if not ready then
		return
	end
	local id = newAction()
	state = "Drawing"
	releaseQueued = false
	anim:Stop("Equip", 0.12)
	anim:Stop("Shoot", 0.12)
	anim:Stop("ShootCharged", 0.12)
	anim:Play("Draw", 0.08)
	setAiming(true)
	after(id, TIMING.Nock, "Nock", function()
		setHooked(true)
	end)
	after(id, TIMING.FullDraw + 0.03, "FullDraw", enterAim)
end

local function onDeactivated()
	if state == "Drawing" then
		releaseQueued = true
	elseif state == "Aiming" then
		fire()
	end
end

-- ---------------------------------------------------------------------------
-- special: "Salto Lunar"
-- ---------------------------------------------------------------------------
local function endLeap()
	if leapConn then
		leapConn:Disconnect()
		leapConn = nil
	end
	if leapVelocity then
		leapVelocity:Destroy()
		leapVelocity = nil
		if root then
			local v = root.AssemblyLinearVelocity
			root.AssemblyLinearVelocity = Vector3.new(0, math.min(v.Y, 0), 0)
		end
	end
end

local function startLeap()
	if not root then
		return
	end
	endLeap()
	local att = root:FindFirstChild("RootAttachment") :: Attachment?
	if not att then
		local a = Instance.new("Attachment")
		a.Name = "RootAttachment"
		a.Parent = root
		att = a
	end
	local airTime = TIMING.Land - TIMING.Jump
	local h = Config.SpecialJumpHeight
	local v0 = 4 * h / airTime
	local g = 8 * h / (airTime * airTime)
	local look = root.CFrame.LookVector
	local flat = Vector3.new(look.X, 0, look.Z)
	local back = if flat.Magnitude > 0.01 then -flat.Unit * (Config.SpecialJumpBack / airTime) else Vector3.zero

	local lv = Instance.new("LinearVelocity")
	lv.Name = "LunarBowLeap"
	lv.Attachment0 = att :: Attachment
	lv.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
	lv.RelativeTo = Enum.ActuatorRelativeTo.World
	lv.MaxForce = 1e6
	lv.VectorVelocity = back + Vector3.new(0, v0, 0)
	lv.Parent = root
	leapVelocity = lv
	local t0 = now()
	leapConn = RunService.Heartbeat:Connect(function()
		local t = now() - t0
		lv.VectorVelocity = back + Vector3.new(0, v0 - g * t, 0)
		if t > airTime + 0.3 then
			endLeap()
		end
	end)
end

local function specialVolley()
	local origin = arrowOrigin()
	local target = aimTarget()
	local base = target - origin
	if base.Magnitude < 1 then
		return
	end
	local targets = {}
	local n = Config.SpecialArrows
	for i = 1, n do
		local yaw = math.rad((i - (n + 1) / 2) * Config.SpecialSpread)
		local dir = CFrame.fromAxisAngle(Vector3.yAxis, yaw):VectorToWorldSpace(base)
		local t = origin + dir
		table.insert(targets, t)
		local hit, normal = predictHit(origin, t)
		BowVFX.fireArrow(origin, hit, "special", normal)
	end
	BowVFX.burst(tool, 40)
	remote:FireServer("Fire", "special", origin, targets)
end

local function finishSpecial(id: number)
	if actionId ~= id or state ~= "Special" then
		return
	end
	endLeap()
	setHooked(false)
	BowVFX.setTrails(tool, false)
	setFacing(nil)
	if humanoid then
		humanoid.AutoRotate = true
	end
	state = "Idle"
end

local function special()
	if not (anim and humanoid and root) then
		return
	end
	if not (state == "Idle" or state == "Drawing" or state == "Aiming" or state == "Equipping") then
		return
	end
	if now() - lastSpecial < Config.SpecialCooldown or humanoid.FloorMaterial == Enum.Material.Air then
		return
	end
	lastSpecial = now()
	local id = newAction()
	state = "Special"
	anim:StopAll(0.08, { Hold = true })
	setHooked(false)
	setAiming(false)
	humanoid.AutoRotate = false
	setFacing(aimTarget())
	BowVFX.setTrails(tool, true)
	anim:Play("Special", 0.05)

	after(id, TIMING.Jump, "Jump", startLeap)
	after(id, TIMING.SpecialDraw, "SpecialDraw", function()
		setHooked(true)
	end)
	after(id, TIMING.SpecialRelease, "SpecialRelease", function()
		setHooked(false)
		specialVolley()
	end)
	after(id, TIMING.Land, "Land", function()
		endLeap()
		if root and humanoid then
			local foot = root.Position - Vector3.new(0, humanoid.HipHeight + root.Size.Y / 2, 0)
			BowVFX.landing(foot)
			remote:FireServer("Land", foot)
		end
	end)
	task.delay(TIMING.SpecialEnd, finishSpecial, id)
end

-- ---------------------------------------------------------------------------
-- equip / unequip
-- ---------------------------------------------------------------------------
local function track(c: Disconnectable)
	table.insert(connections, c)
end

local function wireMarkers(a: BowAnimator.BowAnimator)
	-- markers make the timing follow the animation exactly (also with AdjustSpeed);
	-- the timers in TIMING are only a fallback.
	local equipNumber = equipCount
	local summoned = false
	local function summon()
		if not summoned and equipCount == equipNumber then
			summoned = true
			BowVFX.summon(tool)
		end
	end
	track(a:Get("Equip"):OnMarker("Summon", summon))
	task.delay(TIMING.Summon + 0.05, summon)
	track(a:Get("Draw"):OnMarker("Nock", function()
		if state == "Drawing" then
			trigger("Nock", function()
				setHooked(true)
			end)
		end
	end))
	track(a:Get("Draw"):OnMarker("FullDraw", function()
		if state == "Drawing" then
			trigger("FullDraw", enterAim)
		end
	end))
	local sp = a:Get("Special")
	track(sp:OnMarker("Jump", function()
		trigger("Jump", startLeap)
	end))
	track(sp:OnMarker("Draw", function()
		trigger("SpecialDraw", function()
			setHooked(true)
		end)
	end))
	track(sp:OnMarker("Release", function()
		trigger("SpecialRelease", function()
			setHooked(false)
			specialVolley()
		end)
	end))
end

local function cleanup()
	for _, c in connections do
		c:Disconnect()
	end
	table.clear(connections)
	ContextActionService:UnbindAction(SPECIAL_ACTION)
	endLeap()
	setAiming(false)
	setFacing(nil)
	if humanoid then
		humanoid.AutoRotate = true
	end
	if hud then
		hud:Destroy()
		hud = nil
	end
	UserInputService.MouseIconEnabled = true
	if tool:GetAttribute("Hooked") then
		setHooked(false)
	end
end

local function onEquipped()
	local char = tool.Parent
	if not (char and char:IsA("Model")) then
		return
	end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not (hum and hrp and hrp:IsA("BasePart")) then
		return
	end
	if hum.RigType ~= Enum.HumanoidRigType.R15 then
		warn("[LunarBow] This bow and its animations are made for R15 characters.")
	end
	humanoid, root = hum, hrp
	baseWalkSpeed = hum.WalkSpeed
	defaultFov = camera().FieldOfView

	local a = BowAnimator.new(char, function(name: string, op: string, fade: number?, speed: number?)
		if name ~= "Hold" then -- every client plays Hold by itself
			remote:FireServer("Anim", name, op, fade, speed)
		end
	end)
	anim = a
	equipCount += 1
	wireMarkers(a)

	local id = newAction()
	state = "Equipping"
	equipAt = now()
	BowVFX.hideBow(tool)
	a:Play("Hold", 0.3)
	a:Play("Equip", 0.08)
	task.delay(TIMING.EquipDone, function()
		if actionId == id and state == "Equipping" then
			state = "Idle"
		end
	end)

	hud = buildHud()
	if UserInputService.MouseEnabled then
		UserInputService.MouseIconEnabled = false
	end
	ContextActionService:BindAction(SPECIAL_ACTION, function(_, inputState)
		if inputState == Enum.UserInputState.Begin then
			special()
		end
		return Enum.ContextActionResult.Sink
	end, true, table.unpack(Config.SpecialKeys))
	ContextActionService:SetTitle(SPECIAL_ACTION, "Salto")
	ContextActionService:SetPosition(SPECIAL_ACTION, UDim2.new(1, -180, 1, -130))

	track(hum.Died:Connect(cleanup) :: any)
	track(RunService.RenderStepped:Connect(function()
		local handle = tool:FindFirstChild("BowHandle")
		if handle and handle:IsA("BasePart") then
			lastHandleCF = handle.CFrame
		end
		if (state == "Drawing" or state == "Aiming" or state == "Shooting") and aiming then
			setFacing(aimTarget())
			local still = hum.MoveDirection.Magnitude < 0.1 and hum.FloorMaterial ~= Enum.Material.Air
			local want = still and state ~= "Shooting"
			if want ~= stanceOn then
				stanceOn = want
				if want then
					a:Play("AimStance", 0.25)
				else
					a:Stop("AimStance", 0.2)
				end
			end
		end
		updateHud()
	end) :: any)
end

local function onUnequipped()
	newAction()
	state = "Off"
	cleanup()
	if anim then
		anim:StopAll(0.12)
		anim:Play("Unequip", 0.08)
		local old = anim
		anim = nil
		task.delay(1, function()
			if anim ~= old then
				old:Destroy()
			end
		end)
	end
	BowVFX.dismiss(tool, lastHandleCF)
	remote:FireServer("Dismiss", lastHandleCF)
	humanoid, root = nil, nil
end

tool.Equipped:Connect(onEquipped)
tool.Unequipped:Connect(onUnequipped)
tool.Activated:Connect(beginDraw)
tool.Deactivated:Connect(onDeactivated)
]]></string>
        </Properties>
      </Item>
      <Item class="Model" referent="20">
        <Properties>
          <string name="Name">BowModel</string>
          <bool name="NeedsPivotMigration">false</bool>
        </Properties>
      </Item>
      <Item class="RemoteEvent" referent="21">
        <Properties>
          <string name="Name">BowRemote</string>
        </Properties>
      </Item>
      <Item class="Script" referent="22">
        <Properties>
          <string name="Name">BowServer</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!strict
-- Lunar Bow — server side (lives inside the Tool).
-- Builds the bow, attaches it to the LEFT hand with a Motor6D, validates shots,
-- applies damage and relays cosmetic events to the other clients.

local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local tool = script.Parent :: Tool
local Shared = ReplicatedStorage:WaitForChild("LunarBowShared")
local Config = require(Shared:WaitForChild("Config"))
local BowAssembly = require(Shared:WaitForChild("BowAssembly"))
local AnimationData = require(Shared:WaitForChild("BowAnimationData"))
local FX = Shared:WaitForChild("FX") :: RemoteEvent
local remote = tool:WaitForChild("BowRemote") :: RemoteEvent

BowAssembly.assemble(tool)

local grip: Motor6D? = nil
local lastFire = 0
local lastSpecial = -math.huge
local animBudget = 0
local animBudgetAt = os.clock()

local function ownerOf(): Player?
	local parent = tool.Parent
	if parent and parent:IsA("Backpack") then
		local p = parent.Parent
		return if p and p:IsA("Player") then p else nil
	end
	return if parent then Players:GetPlayerFromCharacter(parent) else nil
end

local function toOthers(except: Player?, ...: any)
	for _, p in Players:GetPlayers() do
		if p ~= except then
			FX:FireClient(p, ...)
		end
	end
end

local function humanoidFrom(inst: Instance): Humanoid?
	local model = inst:FindFirstAncestorOfClass("Model")
	while model do
		local h = model:FindFirstChildOfClass("Humanoid")
		if h then
			return h
		end
		model = model:FindFirstAncestorOfClass("Model")
	end
	return nil
end

local function canDamage(attacker: Player, humanoid: Humanoid): boolean
	if humanoid.Health <= 0 or humanoid.Parent == attacker.Character then
		return false
	end
	local victim = Players:GetPlayerFromCharacter(humanoid.Parent)
	if victim and Config.TeamCheck and not attacker.Neutral and not victim.Neutral and attacker.Team == victim.Team then
		return false
	end
	return true
end

local function damage(attacker: Player, humanoid: Humanoid, amount: number)
	local old = humanoid:FindFirstChild("creator")
	if old then
		old:Destroy()
	end
	local tag = Instance.new("ObjectValue")
	tag.Name = "creator" -- classic kill-credit tag
	tag.Value = attacker
	tag.Parent = humanoid
	Debris:AddItem(tag, 2)
	humanoid:TakeDamage(amount)
end

local function onFire(player: Player, kind: any, origin: any, targets: any)
	if typeof(kind) ~= "string" or typeof(origin) ~= "Vector3" or typeof(targets) ~= "table" then
		return
	end
	if kind ~= "normal" and kind ~= "charged" and kind ~= "special" then
		return
	end
	local character = player.Character
	if not character or tool.Parent ~= character then
		return
	end
	local root = character:FindFirstChild("HumanoidRootPart")
	if not (root and root:IsA("BasePart")) or (origin - root.Position).Magnitude > 15 then
		return
	end
	local now = os.clock()
	if kind == "special" then
		if now - lastSpecial < Config.SpecialCooldown - 0.5 then
			return
		end
		lastSpecial = now
	else
		if now - lastFire < Config.FireCooldown * 0.75 then
			return
		end
		lastFire = now
	end

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { character }
	local maxArrows = if kind == "special" then Config.SpecialArrows else 1
	local speed = (Config.ArrowSpeed :: { [string]: number })[kind]
	local amount = (Config.Damage :: { [string]: number })[kind]

	for i = 1, math.min(#targets, maxArrows) do
		local target = targets[i]
		if typeof(target) ~= "Vector3" then
			continue
		end
		local delta = target - origin
		if delta.Magnitude < 0.5 then
			continue
		end
		local dir = delta.Unit
		local result = Workspace:Raycast(origin, dir * Config.Range, params)
		local hitPos = if result then result.Position else origin + dir * Config.Range
		local normal = if result then result.Normal else -dir
		toOthers(player, "Arrow", origin, hitPos, kind, normal)
		if result then
			local humanoid = humanoidFrom(result.Instance)
			if humanoid and canDamage(player, humanoid) then
				local travel = (hitPos - origin).Magnitude / speed
				task.delay(travel, function()
					if humanoid.Parent and humanoid.Health > 0 then
						damage(player, humanoid, amount)
					end
				end)
			end
		end
	end
end

remote.OnServerEvent:Connect(function(player: Player, action: any, ...: any)
	if ownerOf() ~= player or typeof(action) ~= "string" then
		return
	end
	if action == "Fire" then
		onFire(player, ...)
	elseif action == "Hook" then
		local hooked = (...) == true
		tool:SetAttribute("Hooked", hooked)
		tool:SetAttribute("DrawStart", if hooked then Workspace:GetServerTimeNow() else 0)
	elseif action == "Anim" then
		-- built-in animations are replicated by relaying them to the other clients
		local name, op, fade, speed = ...
		if typeof(name) ~= "string" or AnimationData[name] == nil then
			return
		end
		if op ~= "play" and op ~= "stop" and op ~= "speed" then
			return
		end
		local t = os.clock()
		animBudget = math.max(0, animBudget - (t - animBudgetAt) * 20)
		animBudgetAt = t
		if animBudget > 40 then
			return
		end
		animBudget += 1
		local character = player.Character
		if character then
			toOthers(player, "Anim", character, name, op,
				if typeof(fade) == "number" then fade else nil,
				if typeof(speed) == "number" then speed else nil)
		end
	elseif action == "Dismiss" then
		local cf = ...
		if typeof(cf) == "CFrame" then
			toOthers(player, "Dismiss", cf)
		end
	elseif action == "Land" then
		local pos = ...
		if typeof(pos) == "Vector3" then
			toOthers(player, "Land", pos)
		end
	end
end)

tool.Equipped:Connect(function()
	local character = tool.Parent
	if not (character and character:IsA("Model")) then
		return
	end
	grip = BowAssembly.attachToHand(tool, character)
	tool:SetAttribute("Hooked", false)
	tool:SetAttribute("DrawStart", 0)
	toOthers(Players:GetPlayerFromCharacter(character), "Summon", tool)
end)

tool.Unequipped:Connect(function()
	if grip then
		grip:Destroy()
		grip = nil
	end
	tool:SetAttribute("Hooked", false)
	tool:SetAttribute("DrawStart", 0)
end)
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="23">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="24">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="25">
        <Properties>
          <string name="Name">LunarBowFX</string>
          <string name="Source"><![CDATA[--!strict
-- Lunar Bow — cosmetic effects for EVERY bow in the server (StarterPlayerScripts).
--   * string that bends to the right hand, nocked arrow, charge glow
--   * other players' arrows, impacts, summon / dismiss / landing effects
--   * mirrors other players' built-in animations (when not using published ids)

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("LunarBowShared")
local BowVFX = require(Shared:WaitForChild("BowVFX"))
local BowAnimator = require(Shared:WaitForChild("BowAnimator"))
local BowAssembly = require(Shared:WaitForChild("BowAssembly"))
local AnimationData = require(Shared:WaitForChild("BowAnimationData"))
local FX = Shared:WaitForChild("FX") :: RemoteEvent

local localPlayer = Players.LocalPlayer

type Tracker = { update: (dt: number) -> (), destroy: () -> () }
local trackers: { [Tool]: Tracker } = {}
local animators: { [Model]: BowAnimator.BowAnimator } = {}
local holding: { [Tool]: Model } = {}

local function animatorFor(character: Model): BowAnimator.BowAnimator
	local a = animators[character]
	if not a then
		a = BowAnimator.new(character)
		animators[character] = a
		character.Destroying:Connect(function()
			animators[character] = nil
		end)
	end
	return a :: BowAnimator.BowAnimator
end

local function isLocal(character: Instance?): boolean
	return character ~= nil and character == localPlayer.Character
end

-- other players' Hold loop is started locally (nothing to replicate, works for late joiners)
local function refreshHold(tool: Tool)
	local parent = tool.Parent
	local char = if parent and parent:IsA("Model") and parent:FindFirstChildOfClass("Humanoid") then parent else nil
	local previous = holding[tool]
	if previous and previous ~= char then
		holding[tool] = nil
		if not isLocal(previous) and BowAnimator.usesBuiltin("Hold") and animators[previous] then
			animators[previous]:Stop("Hold", 0.2)
		end
	end
	if char and previous ~= char then
		holding[tool] = char
		if not isLocal(char) and BowAnimator.usesBuiltin("Hold") then
			animatorFor(char):Play("Hold", 0.3)
		end
	end
end

local function addBow(inst: Instance)
	if not inst:IsA("Tool") or trackers[inst] then
		return
	end
	local tool = inst
	task.spawn(function()
		local handle = tool:WaitForChild("BowHandle", 15)
		if not handle or not handle:WaitForChild("StringNock", 15) then
			return
		end
		local tracker = BowVFX.trackBow(tool)
		if tracker then
			trackers[tool] = tracker
		end
		refreshHold(tool)
		tool.AncestryChanged:Connect(function()
			refreshHold(tool)
		end)
	end)
end

local function removeBow(inst: Instance)
	if inst:IsA("Tool") then
		local tracker = trackers[inst]
		if tracker then
			tracker.destroy()
			trackers[inst] = nil
		end
	end
end

CollectionService:GetInstanceAddedSignal(BowAssembly.Tag):Connect(addBow)
CollectionService:GetInstanceRemovedSignal(BowAssembly.Tag):Connect(removeBow)
for _, t in CollectionService:GetTagged(BowAssembly.Tag) do
	addBow(t)
end

RunService.RenderStepped:Connect(function(dt: number)
	for tool, tracker in trackers do
		if not tool.Parent then
			tracker.destroy()
			trackers[tool] = nil
		elseif tool:IsDescendantOf(Workspace) then
			tracker.update(dt)
		end
	end
end)

FX.OnClientEvent:Connect(function(kind: string, ...: any)
	if kind == "Arrow" then
		local origin, hit, arrowKind, normal = ...
		BowVFX.fireArrow(origin, hit, arrowKind, normal)
	elseif kind == "Summon" then
		local tool = ...
		if typeof(tool) == "Instance" then
			BowVFX.hideBow(tool)
			task.delay(0.14, BowVFX.summon, tool)
		end
	elseif kind == "Dismiss" then
		local cf = ...
		BowVFX.dismiss(nil, cf)
	elseif kind == "Land" then
		local pos = ...
		BowVFX.landing(pos)
	elseif kind == "Anim" then
		local character, name, op, fade, speed = ...
		if typeof(character) ~= "Instance" or not character:IsA("Model") or isLocal(character) then
			return
		end
		if typeof(name) ~= "string" or AnimationData[name] == nil then
			return
		end
		if not BowAnimator.usesBuiltin(name) then
			return -- published animations replicate on their own
		end
		local a = animatorFor(character)
		if op == "play" then
			a:Play(name, fade, 1, speed)
		elseif op == "stop" then
			a:Stop(name, fade)
		elseif op == "speed" and typeof(speed) == "number" then
			a:Get(name):AdjustSpeed(speed)
		end
	end
end)
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
